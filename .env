# =============================================================================
# SolaFlow AI - 共享默认配置（.env）
# -----------------------------------------------------------------------------
# 分层规则（Next.js 加载顺序：.env.local 覆盖 .env）：
#   .env          非机密、对所有环境安全的默认值；可提交，禁止写入任何真实凭证
#   .env.local    机密与本机覆盖项；已被 .gitignore 忽略，不得提交
#   .env.example  占位符模板与键位说明；新人从这里开始
#
# ⚠️  部署平台说明：
#     1. Vercel：【不会】读取仓库内任何 env 文件（.env / .env.local 均被忽略）。
#        必须复制到「Project Settings → Environment Variables」并勾选对应环境。
#     2. VPS / Docker / 独立服务器：需显式注入环境变量。本文件是 dev 安全默认值，
#        直接当作生产配置会导致支付指向 devnet，务必用生产值覆盖。
#
# 需要真值的键统一在此留空，实际取值写在 .env.local（本地）或部署平台（线上）。
# =============================================================================


# ---------------------------- 1. 运行时边界 ----------------------------
# 允许的来源白名单，逗号分隔。生产必须为 https:// 开头，否则视为配置缺失。
APP_ALLOWED_ORIGINS=http://localhost:3000

# 部署在反向代理 / CDN / 负载均衡后时设为 true，以准确获取客户端真实 IP。
TRUST_PROXY_HEADERS=false


# ---------------------------- 2. 数据库 / 队列 ----------------------------
# Neon PostgreSQL 连接串。留空 = 数据库能力未配置。
DATABASE_URL=

# Redis 连接串（ioredis / BullMQ 队列与分布式锁）。留空 = 队列能力未配置。
REDIS_URL=


# ---------------------------- 3. 安全密钥（全部留空） ----------------------------
# 以下四项由 lib/server/config/env.ts 校验，缺失会判定为 security unconfigured。
# 生成方式：openssl rand -hex 32
SESSION_SIGNING_KEY=
CSRF_SIGNING_KEY=
OTP_HMAC_KEY=

# 必须是恰好 32 字节的 Base64 编码字符串。生成方式：openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=


# ---------------------------- 4. OTP 投递（可选） ----------------------------
# 自建 HTTP 投递端点与 Bearer 令牌。当前登录已改用 Neon Auth 托管 OTP，
# 这两项仅保留给自建投递路径；留空时相关接口按能力不可用处理。
OTP_DELIVERY_ENDPOINT=
OTP_DELIVERY_BEARER_TOKEN=


# ---------------------------- 5. 计费目录（非机密） ----------------------------
BILLING_CATALOG_VERSION=v1
BILLING_CATALOG_STATUS=current
BILLING_CREDIT_UNIT_PRICE_MINOR=100
BILLING_MINIMUM_CREDITS=100

# 主网计费与结算 worker 总开关；上线前保持 false。
BILLING_ENABLE_MAINNET=false
BILLING_SETTLEMENT_WORKER_ENABLED=false


# ---------------------------- 6. 第三方集成（全部留空） ----------------------------
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=

WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=

# WhatsApp Cloud API 版本；留空使用 v25.0（Meta Messages API 文档示例版本）。
WHATSAPP_GRAPH_API_VERSION=
# 测试消息收件人白名单，逗号分隔 E.164；留空则测试消息不可发送。
WHATSAPP_TEST_RECIPIENTS=


# ---------------------------- 7. 支付开关 ----------------------------
# devnet 测试充值总闸门。默认关闭；需要本地跑 devnet 时才改为 true，
# 并同时提供 SOLANA_RECIPIENT。
PAYMENTS_DEVNET_ENABLED=false

# 线上（NODE_ENV=production）额外闸门：必须显式置 true 才允许 devnet 支付在线上运行。
PAYMENTS_DEVNET_ALLOW_PRODUCTION=false

# Solana Pay 支付链接的站点来源，需与 APP_ALLOWED_ORIGINS 指向同一站点。
PAYMENT_APP_ORIGIN=http://localhost:3000


# ---------------------------- 8. Solana 网络参数 ----------------------------
# 默认 devnet。注意：lib/server/services/billing/config.ts 要求集群与运行环境匹配
# （production ⇔ mainnet-beta），生产部署必须覆盖为 mainnet-beta 及其主网常量。
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# devnet 创世哈希与原生 USDC mint，已与 lib/payments/contracts.ts 的常量对齐。
SOLANA_GENESIS_HASH=EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# 收款地址按部署而定，留空需自行填写。
SOLANA_RECIPIENT=

# SPL Token 程序地址，主网与 devnet 相同。
SOLANA_TOKEN_PROGRAM=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA


# ---------------------------- 9. Neon Auth 托管认证 ----------------------------
# 同一个端点需要三个键位，语义各不相同，不要合并：
#   NEON_AUTH_BASE_URL          服务端 SDK（lib/auth/server.ts）读取，必填
#   NEXT_PUBLIC_NEON_AUTH_URL   浏览器端读取，必须有 NEXT_PUBLIC_ 前缀才会注入
#   NEON_AUTH_URL               兼容别名，供 lib/auth/neon-auth.ts 的降级链使用
NEON_AUTH_BASE_URL=https://ep-falling-sky-b5fgcy67.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-falling-sky-b5fgcy67.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_URL=https://ep-falling-sky-b5fgcy67.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth

# 会话 cookie 签名密钥，至少 32 字符。生成方式：openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
