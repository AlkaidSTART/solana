# =============================================================================
# SolaFlow AI - 环境变量模板（.env.example）
# -----------------------------------------------------------------------------
# 使用方式：
#   1. 本地开发：复制为 .env.local（不是 .env），填入真实值。
#        cp .env.example .env.local
#      .env 已提供 dev 安全默认值，只有需要覆盖或填机密时才写 .env.local。
#   2. 线上部署：Vercel 不读取仓库内 env 文件，需在
#      「Project Settings → Environment Variables」逐项录入。
#
# 分层规则（Next.js 加载顺序：.env.local 覆盖 .env）：
#   .env          非机密、对所有环境安全的默认值；已提交，禁止写入真实凭证
#   .env.local    机密与本机覆盖项；已被忽略，不得提交
#   .env.example  本文件，占位符模板
#
# 本文件中的 <...> 一律为占位符。密钥生成：openssl rand -hex 32（签名类）、
# openssl rand -base64 32（加密类）。
# =============================================================================


# ---------------------------- 1. 运行时边界 ----------------------------
# 允许的来源白名单，逗号分隔。生产必须为 https:// 开头，否则视为配置缺失。
APP_ALLOWED_ORIGINS=<http://localhost:3000 或 https://your-domain.example>

# 部署在反向代理 / CDN / 负载均衡后时设为 true，以准确获取客户端真实 IP。
TRUST_PROXY_HEADERS=<true 或 false>


# ---------------------------- 2. 数据库 / 队列 ----------------------------
# Neon PostgreSQL 连接串。留空 = 数据库能力未配置。
DATABASE_URL=<postgresql://user:password@host/db?sslmode=require>

# Redis 连接串（ioredis / BullMQ 队列与分布式锁）。留空 = 队列能力未配置。
REDIS_URL=<rediss://default:password@host:6379>


# ---------------------------- 3. 安全密钥 ----------------------------
# 以下三项需 >= 32 字节。生成：openssl rand -hex 32
SESSION_SIGNING_KEY=<至少 32 字节随机串>
CSRF_SIGNING_KEY=<至少 32 字节随机串>
OTP_HMAC_KEY=<至少 32 字节随机串>

# 必须是恰好 32 字节的 Base64 编码字符串。生成：openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=<恰好 32 字节的 Base64>


# ---------------------------- 4. OTP 投递（可选） ----------------------------
# 自建 HTTP 投递端点与 Bearer 令牌。当前登录已改用 Neon Auth 托管 OTP，
# 这两项仅保留给自建投递路径；留空时相关接口按能力不可用处理。
OTP_DELIVERY_ENDPOINT=<https://otp-gateway.example/send>
OTP_DELIVERY_BEARER_TOKEN=<bearer token>


# ---------------------------- 5. 计费目录 ----------------------------
BILLING_CATALOG_VERSION=v1
BILLING_CATALOG_STATUS=<current 或 pilot>
BILLING_CREDIT_UNIT_PRICE_MINOR=100
BILLING_MINIMUM_CREDITS=100

# 主网计费与结算 worker 总开关；上线前保持 false。
BILLING_ENABLE_MAINNET=false
BILLING_SETTLEMENT_WORKER_ENABLED=false


# ---------------------------- 6. 第三方集成 ----------------------------
WOOCOMMERCE_CONSUMER_KEY=<woocommerce consumer key>
WOOCOMMERCE_CONSUMER_SECRET=<woocommerce consumer secret>
WOOCOMMERCE_WEBHOOK_SECRET=<woocommerce webhook secret>

WHATSAPP_APP_SECRET=<whatsapp app secret>
WHATSAPP_VERIFY_TOKEN=<whatsapp verify token>
WHATSAPP_ACCESS_TOKEN=<whatsapp access token>
# 留空使用默认 v25.0（Meta Messages API 文档示例版本）
WHATSAPP_GRAPH_API_VERSION=<whatsapp graph api version, for example v25.0>
# 测试消息收件人白名单，逗号分隔 E.164；留空则测试消息不可发送
WHATSAPP_TEST_RECIPIENTS=<comma separated e164 numbers>


# ---------------------------- 7. 支付开关 ----------------------------
# devnet 测试充值总闸门。默认关闭；需要跑 devnet 时才改为 true。
PAYMENTS_DEVNET_ENABLED=<true 或 false>

# 线上（NODE_ENV=production）额外闸门：必须显式置 true 才允许 devnet 支付在线上运行。
PAYMENTS_DEVNET_ALLOW_PRODUCTION=<true 或 false>

# Solana Pay 支付链接的站点来源，需与 APP_ALLOWED_ORIGINS 指向同一站点。
PAYMENT_APP_ORIGIN=<https://your-domain.example>


# ---------------------------- 8. Solana 网络参数 ----------------------------
# 注意：lib/server/services/billing/config.ts 要求集群与运行环境匹配
# （production ⇔ mainnet-beta），生产部署必须使用主网常量。
SOLANA_CLUSTER=<devnet | testnet | mainnet-beta>
SOLANA_RPC_URL=<https://api.devnet.solana.com 或你的私有 RPC>

# 创世哈希需与所选集群一致，否则支付校验会拒绝交易。
# devnet     : EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG
# mainnet-beta: 5eykt4UsFv8P8NJdTREpY1vzqKqZKvdpKuc147dw2N9d
SOLANA_GENESIS_HASH=<对应集群的创世哈希>

# devnet 原生 USDC     : 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# mainnet-beta 原生 USDC: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SOLANA_USDC_MINT=<对应集群的 USDC mint>

SOLANA_RECIPIENT=<收款钱包地址>

# SPL Token 程序地址，主网与 devnet 相同。
SOLANA_TOKEN_PROGRAM=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA


# ---------------------------- 9. Neon Auth 托管认证 ----------------------------
# 同一个端点需要三个键位，语义各不相同，不要合并：
#   NEON_AUTH_BASE_URL          服务端 SDK（lib/auth/server.ts）读取，必填
#   NEXT_PUBLIC_NEON_AUTH_URL   浏览器端读取，必须有 NEXT_PUBLIC_ 前缀才会注入
#   NEON_AUTH_URL               兼容别名，供 lib/auth/neon-auth.ts 的降级链使用
NEON_AUTH_BASE_URL=<https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth>
NEXT_PUBLIC_NEON_AUTH_URL=<与 NEON_AUTH_BASE_URL 同值>
NEON_AUTH_URL=<与 NEON_AUTH_BASE_URL 同值>

# 会话 cookie 签名密钥，至少 32 字符。生成：openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=<至少 32 字符随机串>
